      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Langkah 1: Memuat data (pastikan data sudah berhasil dimuat sebelumnya)\n",
        "# data = pd.read_excel('/content/Data_Kelambatan_KA_Daop1_fullclean_fuzzy_jenis.csv')\n",
        "\n",
        "# Langkah 2: Pastikan kolom 'Tgl_KA' diubah menjadi tipe datetime\n",
        "data['Tgl_KA'] = pd.to_datetime(data['Tgl_KA'], errors='coerce')\n",
        "\n",
        "# Langkah 3: Pisahkan data berdasarkan nilai positif dan negatif di kolom 'Andil'\n",
        "data_pos = data[data['Andil'] > 0]  # Data dengan nilai Andil positif\n",
        "data_neg = data[data['Andil'] < 0]  # Data dengan nilai Andil negatif\n",
        "\n",
        "# Langkah 4: Kelompokkan data berdasarkan tanggal dan jumlahkan nilai Andil\n",
        "data_pos_daily = data_pos.groupby('Tgl_KA')['Andil'].sum().reset_index()\n",
        "data_neg_daily = data_neg.groupby('Tgl_KA')['Andil'].sum().reset_index()\n",
        "\n",
        "# Langkah 5: Urutkan data berdasarkan tanggal\n",
        "data_pos_daily = data_pos_daily.sort_values(by='Tgl_KA')\n",
        "data_neg_daily = data_neg_daily.sort_values(by='Tgl_KA')\n",
        "\n",
        "# Langkah 6: Membuat plot dengan dua tren line terpisah\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "# Tren line untuk Menambah Kelambatan (Andil Positif)\n",
        "# Andil Positif tetap di atas sumbu X (nilai positif)\n",
        "plt.plot(data_pos_daily['Tgl_KA'], data_pos_daily['Andil'], label='Menambah Kelambatan', color='red')\n",
        "\n",
        "# Tren line untuk Mengurangi Kelambatan (Andil Negatif)\n",
        "# Andil Negatif digambarkan di bawah sumbu X (nilai negatif)\n",
        "plt.plot(data_neg_daily['Tgl_KA'], data_neg_daily['Andil'], label='Mengurangi Kelambatan', color='green')\n",
        "\n",
        "# Menambahkan garis pemisah di tengah\n",
        "plt.axhline(y=0, color='black', linestyle='--', label='Pemisah (0)')\n",
        "\n",
        "# Menambahkan judul, label, dan legend\n",
        "plt.title('Tren Line Menambah dan Mengurangi Kelambatan')\n",
        "plt.xlabel('Tanggal')\n",
        "plt.ylabel('Jumlah Andil Harian')\n",
        "plt.legend()\n",
        "\n",
        "# Mengatur tampilan sumbu X agar tanggal lebih terbaca\n",
        "plt.xticks(rotation=45)\n",
        "\n",
        "# Menggunakan skala linier pada sumbu Y\n",
        "plt.yscale('linear')  # Menggunakan skala linier agar perbedaan antara nilai positif dan negatif tetap terlihat\n",
        "\n",
        "# Menghindari pemotongan plot\n",
        "plt.tight_layout()\n",
        "\n",
        "# Menampilkan plot\n",
        "plt.show()\n"
      ]
