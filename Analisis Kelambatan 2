        "# Pusat peta diatur di antara Jakarta dan Cikampek (can be adjusted if top 5 locations are very clustered)\n",
        "m_top5 = folium.Map(location=[-6.28, 107.10], zoom_start=10, tiles='CartoDB positron')\n",
