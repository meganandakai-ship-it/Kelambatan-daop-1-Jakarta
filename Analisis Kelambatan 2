        "for idx, row in agg_data_top5.iterrows():\n",
        "    # Mengatur ukuran lingkaran berdasarkan total delay (dinamis)\n",
        "    # Dibagi 30 agar tidak terlalu besar menutupi peta, dan max 20\n",
        "    radius_size = min(row['Andil'] / 30, 20)\n",
        "    if radius_size < 5: radius_size = 5 # Ukuran minimum\n",
        "\n",
        "    # Membuat popup dengan informasi detail\n",
        "    popup_html = f\"\"\"\n",
        "        <b>Lokasi:</b> {row['Lokasi']}<br>\n",
        "        <b>Total Keterlambatan:</b> {row['Andil']} menit<br>\n",
        "        <b>Jumlah Kejadian:</b> {row['No_KA']} kali<br>\n",
        "        <b>Penyebab Terbanyak:</b> {row['Nama_Penyebab']}<br>\n",
        "    \"\"\"\n",
        "\n",
        "    # Menambahkan lingkaran ke peta\n",
        "    folium.CircleMarker(\n",
        "        location=row['Coordinates'],\n",
        "        radius=radius_size,\n",
        "        popup=folium.Popup(popup_html, max_width=300),\n",
        "        color='red',\n",
        "        fill=True,\n",
        "        fill_color='red',\n",
        "        fill_opacity=0.6\n",
        "    ).add_to(m_top5)\n",
        "\n",
