        "# Read the uploaded file directly from memory using BytesIO\n",
        "df = pd.read_excel(io.BytesIO(uploaded[filename]))\n",
        "\n",
        "# Re-create df_delay from previous successful cell q1t-pxYaDGBu\n",
        "df['Andil'] = pd.to_numeric(df['Andil'], errors='coerce')\n",
        "df['Tgl_KA'] = pd.to_datetime(df['Tgl_KA'], errors='coerce')\n",
        "\n",
        "# Filter only delay data\n",
        "df_delay = df[df['Andil'] > 0].copy()\n",
        "\n",
        "# Add time columns (as per q1t-pxYaDGBu)\n",
        "df_delay['Bulan'] = df_delay['Tgl_KA'].dt.month_name()\n",
        "df_delay['Hari'] = df_delay['Tgl_KA'].dt.day_name()\n",
        "\n",
        "\n",
        "try:\n",
        "    # 1. MENCARI INSIDEN TUNGGAL TERPARAH\n",
        "    # Mengurutkan data berdasarkan durasi 'Andil' terbesar\n",
        "    top_incidents = df_delay.sort_values('Andil', ascending=False).head(10)\n",
        "\n",
        "    # Membuat label agar mudah dibaca di grafik (Nama KA + Lokasi)\n",
        "    top_incidents['Event_Label'] = top_incidents['Nama_KA'] + ' (' + top_incidents['Lokasi'] + ')'\n",
        "\n",
        "    # 2. MENCARI JENIS PENYEBAB TERPARAH (RATA-RATA)\n",
        "    severity_stats = df_delay.groupby('Nama_Penyebab').agg({\n",
        "        'Andil': ['mean', 'count']\n",
        "    }).reset_index()\n",
        "    severity_stats.columns = ['Penyebab', 'Rata_rata_Dampak', 'Frekuensi']\n",
        "\n",
        "    # Filter hanya penyebab yang terjadi lebih dari sekali agar valid\n",
        "    top_severe_causes = severity_stats[severity_stats['Frekuensi'] > 1].sort_values('Rata_rata_Dampak', ascending=False).head(10)\n",
        "\n",
        "    # --- VISUALISASI ---\n",
        "    fig, axes = plt.subplots(2, 1, figsize=(12, 12))\n",
