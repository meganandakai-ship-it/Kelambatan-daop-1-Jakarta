        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# ==========================================\n",
        "# 1. PERSIAPAN DATA KHUSUS DOMINO\n",
        "# ==========================================\n",
        "filename = 'Data_Kelambatan_KA_Daop1_fullclean_fuzzy_jenis.xlsx'\n",
        "\n",
        "# Initialize domino_analysis to None so it exists even if try block fails\n",
        "domino_analysis = None\n",
        "\n",
        "try:\n",
        "    df_domino = pd.read_excel(filename)\n",
        "    df_domino['Andil'] = pd.to_numeric(df_domino['Andil'], errors='coerce')\n",
        "    df_domino['Tgl_KA'] = pd.to_datetime(df_domino['Tgl_KA'], errors='coerce') # Ensure Tgl_KA is datetime\n",
        "    # Filter hanya yang terlambat\n",
        "    df_delay_domino = df_domino[df_domino['Andil'] > 0].copy()\n",
        "\n",
        "    # KUNCI ANALISIS DOMINO:\n",
        "    # Kita mengelompokkan berdasarkan Tanggal dan ID Penyebab yang sama.\n",
        "    # Jika 1 ID Penyebab pada tanggal yang sama muncul di banyak Nomor KA, itu adalah DOMINO.\n",
        "    domino_analysis = df_delay_domino.groupby(['Tgl_KA', 'Id_Penyebab', 'Nama_Penyebab'])['No_KA'].nunique().reset_index()\n",
        "    domino_analysis.columns = ['Tgl_KA', 'Id_Penyebab', 'Nama_Penyebab', 'Jumlah_KA_Terdampak']\n",
        "\n",
        "    # Kategorisasi: Apakah Single atau Domino?\n",
        "    domino_analysis['Tipe_Insiden'] = domino_analysis['Jumlah_KA_Terdampak'].apply(\n",
        "        lambda x: 'Insiden Terisolasi (1 KA)' if x == 1 else 'Efek Domino (>1 KA)'\n",
        "    )\n",
        "\n",
        "    print(\"✅ Analisis Domino Siap.\")\n",
        "\n",
        "except Exception as e:\n",
        "    print(f\"❌ Error: {e}\")\n",
        "\n",
        "# ==========================================\n",
        "# 2. VISUALISASI EFEK DOMINO\n",
        "# ==========================================\n",
        "# Only proceed with plotting if domino_analysis was successfully created\n",
        "if domino_analysis is not None:\n",
        "    sns.set_theme(style=\"whitegrid\")\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(16, 7))\n",
        "\n",
        "    # --- GRAFIK 1: PROPORSI KEJADIAN (PIE CHART) ---\n",
        "    # Menghitung proporsi\n",
        "    pie_data = domino_analysis['Tipe_Insiden'].value_counts()\n",
        "\n",
        "    # Warna: Terisolasi (Biru/Aman), Domino (Merah/Bahaya)\n",
        "    colors = ['#66b3ff', '#ff9999']\n",
        "    axes[0].pie(pie_data, labels=pie_data.index, autopct='%1.1f%%', startangle=140, colors=colors,\n",
        "                explode=(0, 0.1), shadow=True)\n",
        "    axes[0].set_title('Presentase Kejadian yang berefek Domino', fontsize=14, fontweight='bold')\n",
        "\n",
        "\n",
        "    # --- GRAFIK 2: TOP PENYEBAB YANG PALING \"MENULAR\" ---\n",
        "    # Kita hanya ambil data yang Tipe-nya \"Efek Domino\"\n",
        "    hanya_domino = domino_analysis[domino_analysis['Jumlah_KA_Terdampak'] > 1]\n",
        "\n",
        "    # Hitung penyebab mana yang paling sering memicu domino\n",
        "    top_viral_causes = hanya_domino['Nama_Penyebab'].value_counts().head(5)\n",
        "\n",
        "    sns.barplot(x=top_viral_causes.values, y=top_viral_causes.index, palette='Reds_r', ax=axes[1], hue=top_viral_causes.index, legend=False)\n",
        "    axes[1].set_title('Top 5 Kejadian Paling Sering Memicu Efek Domino', fontsize=14, fontweight='bold')\n",
        "    axes[1].set_xlabel('Frekuensi Memicu Efek Domino')\n",
        "\n",
        "    # --- STATISTIK TAMBAHAN (UNTUK NARASI) ---\n",
        "    avg_impact = hanya_domino['Jumlah_KA_Terdampak'].mean()\n",
        "    max_impact = hanya_domino['Jumlah_KA_Terdampak'].max()\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    print(\"\\n=== RANGKUMAN STATISTIK DOMINO ===\")\n",
        "    print(f\"1. Rata-rata Dampak: Jika terjadi efek domino, 1 masalah biasanya menulari {avg_impact:.1f} kereta.\")\n",
