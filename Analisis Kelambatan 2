        "# ==========================================\n",
        "# ANALISIS 1: ESTIMASI KERUGIAN FINANSIAL (THE MONEY SLIDE)\n",
        "# ==========================================\n",
        "# ASUMSI BIAYA PER MENIT (SHADOW PRICE)\n",
        "# Dalam studi kasus MBA, Anda harus membuat asumsi logis.\n",
        "# Misal:\n",
        "# - KA Barang: Denda keterlambatan logistik mahal (Rp 500rb/menit)\n",
        "# - KA Jarak Jauh: Kompensasi/Reputasi (Rp 200rb/menit)\n",
        "# - Commuter: Subsidi/Efisiensi (Rp 50rb/menit)\n",
        "\n",
        "import matplotlib.ticker as ticker # Import matplotlib.ticker for axis formatting\n",
        "\n",
        "cost_assumptions = {\n",
        "    'Kereta Barang': 500000,\n",
        "    'Kereta Jarak Jauh': 200000,\n",
        "    'Kereta Lokal Commuter Line': 50000,\n",
        "    'Kereta Bandara': 100000\n",
        "}\n",
        "\n",
        "# Fungsi mapping biaya (default Rp 100rb jika jenis tidak dikenal)\n",
        "def calculate_cost(row):\n",
        "    rate = cost_assumptions.get(row['Jenis_Kereta'], 100000)\n",
        "    return row['Andil'] * rate\n",
        "\n",
        "# Hitung total kerugian\n",
        "df_delay['Estimasi_Kerugian'] = df_delay.apply(calculate_cost, axis=1)\n",
        "financial_impact = df_delay.groupby('Jenis_Kereta')['Estimasi_Kerugian'].sum().sort_values(ascending=False)\n",
        "\n",
