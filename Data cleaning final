    {
      "cell_type": "code",
      "source": [
        "\"\"\"\n",
        "data_cleaning_and_classify_final.py\n",
        "Final pipeline: cleaning, fuzzy grouping, kategori penyebab, andil_status, jenis kereta.\n",
        "Dependencies:\n",
        "    pip install pandas openpyxl\n",
        "\n",
        "Usage:\n",
        "    python data_cleaning_and_classify_final.py\n",
        "\n",
        "Adjust INPUT_PATH if file is in another folder.\n",
        "\"\"\"\n",
        "\n",
        "from pathlib import Path\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import re\n",
        "from difflib import get_close_matches, SequenceMatcher\n",
        "\n",
        "# ----------------------- CONFIG -----------------------\n",
        "INPUT_PATH = Path(\"Data Kelambatan KA Daop 1 Jakarta.csv\")  # ganti path jika diperlukan\n",
        "OUTPUT_DIR = Path(\".\")  # ganti ke '/mnt/data' atau folder lain bila perlu\n",
        "\n",
        "# Filenames to write\n",
        "OUT_FULL_CSV = OUTPUT_DIR / \"Data_Kelambatan_KA_Daop1_fullclean_fuzzy_jenis.csv\"\n",
        "OUT_FULL_XLSX = OUTPUT_DIR / \"Data_Kelambatan_KA_Daop1_fullclean_fuzzy_jenis.xlsx\"\n",
        "OUT_ONLY_BERTAMBAH_CSV = OUTPUT_DIR / \"only_bertambah.csv\"\n",
        "OUT_ONLY_BERTAMBAH_XLSX = OUTPUT_DIR / \"only_bertambah.xlsx\"\n",
        "OUT_ONLY_BERKURANG_CSV = OUTPUT_DIR / \"only_berkurang.csv\"\n",
        "OUT_ONLY_BERKURANG_XLSX = OUTPUT_DIR / \"only_berkurang.xlsx\"\n",
        "\n",
        "# ----------------------- HELPERS -----------------------\n",
        "def clean_whitespace_text(s):\n",
        "    if pd.isna(s):\n",
        "        return s\n",
        "    s2 = str(s).strip()\n",
        "    s2 = re.sub(r'\\s+', ' ', s2)\n",
        "    return s2\n",
        "\n",
        "def normalize_string_for_matching(s):\n",
        "    if pd.isna(s):\n",
        "        return \"\"\n",
        "    return re.sub(r'[^0-9a-zA-Z\\s]', ' ', str(s)).lower().strip()\n",
        "\n",
        "def jaccard_token_score(a, b):\n",
        "    tokens_a = set(re.findall(r'\\w+', a.lower()))\n",
        "    tokens_b = set(re.findall(r'\\w+', b.lower()))\n",
        "    if not tokens_a and not tokens_b:\n",
        "        return 0.0\n",
        "    inter = len(tokens_a & tokens_b)\n",
        "    union = len(tokens_a | tokens_b)\n",
        "    return inter / union if union > 0 else 0.0\n",
        "\n",
        "# ----------------------- STEP 0: Load -----------------------\n",
        "print(\"Loading data from:\", INPUT_PATH)\n",
        "df = pd.read_csv(INPUT_PATH, dtype=str)  # load as string to preserve formatting\n",
        "print(\"Loaded rows:\", len(df))\n",
        "\n",
        "# ----------------------- STEP 1: Standardize column names -----------------------\n",
        "# Make a mapping of original->clean names but keep originals for reference\n",
        "orig_columns = df.columns.tolist()\n",
        "clean_columns = [re.sub(r'\\s+','_',c.strip()).lower() for c in orig_columns]\n",
        "df.columns = clean_columns\n",
        "print(\"Columns normalized. Example columns:\", df.columns[:10].tolist())\n",
        "\n",
        "# Try to detect commonly used column names (robust)\n",
        "# expected columns (based on earlier discussion): tgl_ka, no_ka, nama_ka, id_penyebab, nama_penyebab, id_akibat, lokasi, jenis_lokasi, andil, keterangan\n",
        "# We'll handle case-insensitively using the cleaned names\n",
        "def find_col(possible_names):\n",
        "    possible = [p.lower().replace(' ','_') for p in possible_names]\n",
        "    for p in possible:\n",
        "        if p in df.columns:\n",
        "            return p\n",
        "    # fallback: search token presence\n",
        "    for c in df.columns:\n",
        "        for token in possible:\n",
        "            t = token.replace('_','')\n",
        "            if t and t in c.replace('_',''):\n",
        "                return c\n",
        "    return None\n",
        "\n",
        "col_tgl = find_col([\"tgl_ka\", \"tanggal\", \"tgl\"])\n",
        "col_no_ka = find_col([\"no_ka\",\"no ka\",\"no_ka\"])\n",
        "col_nama_ka = find_col([\"nama_ka\",\"nama_ka\",\"nama kereta\",\"nama_ka\"])\n",
        "col_nama_penyebab = find_col([\"nama_penyebab\",\"penyebab\",\"nama penyebab\"])\n",
        "col_andil = find_col([\"andil\",\"andil (menit)\",\"andil_menit\"])\n",
        "\n",
        "print(\"Detected columns:\")\n",
        "print(\"  tgl:\", col_tgl)\n",
        "print(\"  no_ka:\", col_no_ka)\n",
        "print(\"  nama_penyebab:\", col_nama_penyebab)\n",
        "print(\"  andil:\", col_andil)\n",
        "\n",
        "# ----------------------- STEP 2: Parse dates -----------------------\n",
        "if col_tgl:\n",
        "    try:\n",
        "        df[col_tgl] = pd.to_datetime(df[col_tgl], errors='coerce', dayfirst=True)\n",
        "    except Exception:\n",
        "        # fallback: keep original string if parsing fails\n",
        "        pass\n",
        "\n",
        "# ----------------------- STEP 3: Clean text columns -----------------------\n",
        "for c in df.select_dtypes(include='object').columns:\n",
        "    df[c] = df[c].apply(clean_whitespace_text)\n",
        "\n",
        "# ----------------------- STEP 4: Create cleaned nama_penyebab field -----------------------\n",
        "if col_nama_penyebab:\n",
        "    # normalize to lowercase and collapse whitespace\n",
        "    df['nama_penyebab_clean'] = df[col_nama_penyebab].astype(str).str.lower().str.replace(r'\\s+', ' ', regex=True).str.strip()\n",
        "    # small canonical replacements (extend this dictionary as needed)\n",
        "    canonical_replacements = {\n",
        "        'imbas faktor gangguan persinyalan elektrik (peralatan dalam)': 'gangguan persinyalan elektrik',\n",
        "        'imbas faktor perbaikan bantalan jembatan': 'perbaikan bantalan jembatan',\n",
        "        'imbas faktor perbaikan kawat troli laa': 'perbaikan kawat troli laa',\n",
        "        'imbas kebakaran di rangkaian ka': 'kebakaran pada rangkaian',\n",
        "    }\n",
        "    df['nama_penyebab_clean'] = df['nama_penyebab_clean'].replace(canonical_replacements)\n",
        "else:\n",
        "    df['nama_penyebab_clean'] = df.iloc[:,0].astype(str).apply(lambda x: \"\")  # safe fallback\n",
        "\n",
        "# ----------------------- STEP 5: Basic category mapping (rule-based) -----------------------\n",
        "def categorize_basic(cause):\n",
        "    if pd.isna(cause) or str(cause).strip().lower() in ['nan','none','']:\n",
        "        return \"Lainnya\"\n",
        "    c = str(cause).lower()\n",
        "    # Prasarana keywords (extended)\n",
        "    prasarana_keys = [\"rel\",\"track\",\"bantalan\",\"jembatan\",\"sinyal\",\"persinyal\",\"persinyalan\",\n",
        "                      \"elektrik\",\"listrik\",\"kawat\",\"troli\",\"trolley\",\"radiolok\",\"komputer\",\n",
        "                      \"track merah\",\"count\",\"switch\",\"points\",\"anjlok\",\"jalur\",\"kawat troli\",\n",
        "                      \"perbaikan kawat\",\"perbaikan bantalan\"]\n",
        "    for k in prasarana_keys:\n",
        "        if k in c:\n",
        "            return \"Prasarana\"\n",
        "    # Sarana\n",
        "    sarana_keys = [\"lok\",\"rangkaian\",\"pintu\",\"compress\",\"rem\",\"ac\",\"genset\",\"engine\",\"mesin\",\"motor\",\"lokomotif\",\"gerbong\",\"bogie\"]\n",
        "    for k in sarana_keys:\n",
        "        if k in c:\n",
        "            return \"Sarana\"\n",
        "    # Operasional\n",
        "    operasional_keys = [\"penumpang\",\"bongkar\",\"muat\",\"blb\",\"antri\",\"taktis\",\"boarding\",\"alight\",\"naik\",\"turun\",\"pelayanan\",\"tunggu\",\"perlintasan\",\"ka tertahan\",\"taktis pengendalian\"]\n",
        "    for k in operasional_keys:\n",
        "        if k in c:\n",
        "            return \"Operasional\"\n",
        "    # Eksternal\n",
        "    eksternal_keys = [\"kebakaran\",\"banjir\",\"cuaca\",\"pihak\",\"pelintasan\",\"kecelakaan\",\"gempa\",\"hewan\",\"kabel putus\"]\n",
        "    for k in eksternal_keys:\n",
        "        if k in c:\n",
        "            return \"Eksternal\"\n",
        "    # Kesehatan\n",
        "    kesehatan_keys = [\"sakit\",\"medis\",\"meninggal\",\"koma\",\"evakuasi\",\"penumpang sakit\"]\n",
        "    for k in kesehatan_keys:\n",
        "        if k in c:\n",
        "            return \"Kesehatan\"\n",
        "    return \"Lainnya\"\n",
        "\n",
        "df['kategori_initial'] = df['nama_penyebab_clean'].apply(categorize_basic)\n",
        "\n",
        "# ----------------------- STEP 6: Build canonical map from frequent causes -----------------------\n",
        "# Use top-N frequent phrases as canonical references\n",
        "top_n = 500\n",
        "freq_causes = df['nama_penyebab_clean'].value_counts().head(top_n).index.tolist()\n",
        "canonical_map = {cause: categorize_basic(cause) for cause in freq_causes}\n",
        "\n",
        "# ----------------------- STEP 7: Fuzzy grouping for entries labelled 'Lainnya' -----------------------\n",
        "# We'll try heuristic keyword fixes first, then fuzzy match to canonical_map keys, then token overlap Jaccard\n",
        "corrected = {}\n",
        "threshold = 0.70  # similarity threshold for get_close_matches\n",
        "\n",
        "unique_lain = df.loc[df['kategori_initial']=='Lainnya', 'nama_penyebab_clean'].dropna().unique().tolist()\n",
        "\n",
        "for u in unique_lain:\n",
        "    u_low = u.lower()\n",
        "    # Heuristic keyword mapping (strong signals)\n",
        "    if any(k in u_low for k in [\"kawat\",\"troli\",\"trolley\",\"perbaikan kawat\",\"troli laa\",\"kawat laa\",\"perbaikan troli\"]):\n",
        "        corrected[u] = \"Prasarana\"\n",
        "        continue\n",
        "    if \"anjlok\" in u_low or \"anjlokan\" in u_low or \"anjlog\" in u_low:\n",
        "        corrected[u] = \"Prasarana\"\n",
        "        continue\n",
        "    if any(k in u_low for k in [\"taktis\",\"tunggu waktu berangkat\",\"tunggu rangkaian\",\"ka tertahan\",\"perlintasan ramai\",\"perlintasan ramai kendaraan\"]):\n",
        "        corrected[u] = \"Operasional\"\n",
        "        continue\n",
        "    # Fuzzy match against frequent canonical phrases\n",
        "    matches = get_close_matches(u_low, canonical_map.keys(), n=3, cutoff=threshold)\n",
        "    if matches:\n",
        "        corrected[u] = canonical_map[matches[0]]\n",
        "        continue\n",
        "    # Token overlap (Jaccard-like) fallback\n",
        "    best_match = None\n",
        "    best_score = 0.0\n",
        "    for cand in canonical_map.keys():\n",
        "        score = jaccard_token_score(u_low, cand)\n",
        "        if score > best_score:\n",
        "            best_score = score\n",
        "            best_match = cand\n",
        "    if best_score >= 0.5 and best_match is not None:\n",
        "        corrected[u] = canonical_map[best_match]\n",
        "    # else leave uncorrected -> remain \"Lainnya\"\n",
        "\n",
        "# Apply correction rules to create final kategori\n",
        "def apply_correction(cause):\n",
        "    if pd.isna(cause) or str(cause).strip().lower() in ['nan','none','']:\n",
        "        return \"Lainnya\"\n",
        "    if cause in corrected:\n",
        "        return corrected[cause]\n",
        "    # else use initial\n",
        "    return categorize_basic(cause)\n",
        "\n",
        "df['kategori'] = df['nama_penyebab_clean'].apply(apply_correction)\n",
        "\n",
        "# ----------------------- STEP 8: ANDIL handling (no imputation, preserve negatives) -----------------------\n",
        "# Determine the andil column and convert to numeric (keep NaN if invalid)\n",
        "if col_andil and col_andil in df.columns:\n",
        "    df[col_andil] = pd.to_numeric(df[col_andil], errors='coerce')\n",
        "    andil_col = col_andil\n",
        "else:\n",
        "    # try common name 'andil'\n",
        "    andil_candidates = [c for c in df.columns if 'andil' in c]\n",
        "    andil_col = andil_candidates[0] if andil_candidates else None\n",
        "    if andil_col:\n",
        "        df[andil_col] = pd.to_numeric(df[andil_col], errors='coerce')\n",
        "\n",
        "# Create andil_status (bertambah/berkurang/tetap/missing)\n",
        "def andil_status_value(v):\n",
        "    if pd.isna(v):\n",
        "        return \"missing\"\n",
        "    try:\n",
        "        v = float(v)\n",
        "    except:\n",
        "        return \"missing\"\n",
        "    if v > 0:\n",
        "        return \"bertambah\"\n",
        "    elif v < 0:\n",
        "        return \"berkurang\"\n",
        "    else:\n",
        "        return \"tetap\"\n",
        "\n",
        "df['andil_status'] = df[andil_col].apply(andil_status_value) if andil_col else \"missing\"\n",
        "\n",
        "# ----------------------- STEP 9: Classify Jenis Kereta from No_KA -----------------------\n",
        "# find no_ka column robustly\n",
        "if col_no_ka and col_no_ka in df.columns:\n",
        "    no_ka_col = col_no_ka\n",
        "else:\n",
        "    # guess column with tokens 'no' and 'ka'\n",
        "    no_ka_col = None\n",
        "    for c in df.columns:\n",
        "        if 'no' in c and 'ka' in c:\n",
        "            no_ka_col = c\n",
        "            break\n",
        "    if not no_ka_col:\n",
        "        # fallback to first column that looks like numbers and short\n",
        "        no_ka_col = df.columns[0]\n",
        "\n",
        "# ensure string and strip\n",
        "df[no_ka_col] = df[no_ka_col].astype(str).str.strip()\n",
        "\n",
        "def kategori_kereta(no_ka):\n",
        "    if pd.isna(no_ka) or str(no_ka).strip().lower() in ['nan','none','']:\n",
        "        return \"Tidak diketahui\"\n",
        "    s = str(no_ka).strip()\n",
        "    # Fakultatif\n",
        "    if s.endswith(\"F\"):\n",
        "        return \"Kereta Fakultatif\"\n",
        "    perubahan = s.endswith(\"A\")\n",
        "    # remove trailing letters and slashes\n",
        "    no = re.sub(r\"[A-Za-z]+$\", \"\", s).replace(\"/\", \"\")\n",
        "    if \"KP\" in s.upper():\n",
        "        jenis = \"KP\"\n",
        "        if perubahan:\n",
        "            jenis += \" Perubahan\"\n",
        "        return jenis\n",
        "    if not no.isdigit():\n",
        "        jenis = \"Tidak diketahui\"\n",
        "        if perubahan:\n",
        "            jenis += \" Perubahan\"\n",
        "        return jenis\n",
        "    num = int(no)\n",
        "    # rules\n",
        "    if (1 <= num <= 222) or (245 <= num <= 300):\n",
        "        jenis = \"Kereta Jarak Jauh\"\n",
        "    elif 220 <= num <= 230:\n",
        "        jenis = \"Kereta Lokal\"\n",
        "    elif (str(num).startswith(\"2\") or str(num).startswith(\"7\")) and len(str(num)) == 4:\n",
        "        jenis = \"Kereta Barang\"\n",
        "    elif num == 321:\n",
        "        jenis = \"Kereta Lokal Commuter Line\"\n",
        "    elif 325 <= num <= 338:\n",
        "        jenis = \"Kereta Lokal Commuter Line\"\n",
        "    elif 341 <= num <= 346:\n",
        "        jenis = \"Kereta Lokal\"\n",
        "    elif 301 <= num <= 304:\n",
        "        jenis = \"Parcel\"\n",
        "    else:\n",
        "        jenis = \"Tidak diketahui\"\n",
        "    if perubahan:\n",
        "        jenis += \" Perubahan\"\n",
        "    return jenis\n",
        "\n",
        "df['Jenis_Kereta'] = df[no_ka_col].apply(kategori_kereta)\n",
        "\n",
        "# ----------------------- STEP 10: Save outputs -----------------------\n",
        "print(\"Saving full cleaned files...\")\n",
        "# save full cleaned dataset\n",
        "df.to_csv(OUT_FULL_CSV, index=False)\n",
        "df.to_excel(OUT_FULL_XLSX, index=False)\n",
        "\n",
        "# save only bertambah / berkurang (based on andil_status)\n",
        "df_bertambah = df[df['andil_status'] == \"bertambah\"].copy()\n",
        "df_berkurang = df[df['andil_status'] == \"berkurang\"].copy()\n",
        "\n",
        "print(\"Counts -> bertambah:\", len(df_bertambah), \"berkurang:\", len(df_berkurang))\n",
        "\n",
        "df_bertambah.to_csv(OUT_ONLY_BERTAMBAH_CSV, index=False)\n",
        "df_bertambah.to_excel(OUT_ONLY_BERTAMBAH_XLSX, index=False)\n",
        "df_berkurang.to_csv(OUT_ONLY_BERKURANG_CSV, index=False)\n",
        "df_berkurang.to_excel(OUT_ONLY_BERKURANG_XLSX, index=False)\n",
        "\n",
        "print(\"All files saved to:\", OUTPUT_DIR.resolve())\n",
        "print(\"Files created:\")\n",
        "print(\" -\", OUT_FULL_CSV)\n",
        "print(\" -\", OUT_FULL_XLSX)\n",
        "print(\" -\", OUT_ONLY_BERTAMBAH_CSV)\n",
        "print(\" -\", OUT_ONLY_BERTAMBAH_XLSX)\n",
        "print(\" -\", OUT_ONLY_BERKURANG_CSV)\n",
        "print(\" -\", OUT_ONLY_BERKURANG_XLSX)\n",
        "\n",
        "# ----------------------- OPTIONAL: produce quick summaries -----------------------\n",
        "print(\"\\nTop 10 categories (by count):\")\n",
        "print(df['kategori'].value_counts().head(10).to_string())\n",
        "\n",
        "if andil_col:\n",
        "    print(\"\\nANDIL stats:\")\n",
        "    print(df[andil_col].describe().to_string())\n",
        "else:\n",
        "    print(\"\\nANDIL column not detected; andil processing skipped.\")\n",
        "\n",
        "# End of script\n"
